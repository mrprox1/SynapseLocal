{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window. Fs paths are granted at runtime per workspace (allow_workspace).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "fs:default",
    "dialog:default",
    "store:default",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-watch",
    "fs:allow-rename",
    "fs:allow-mkdir",
    "fs:allow-unwatch"
  ]
}
